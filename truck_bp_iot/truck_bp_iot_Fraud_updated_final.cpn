            <ml id="ID1481478222">fun step_rfid_position_register_to_empty_new (rfid : string, pickupplan_id : string) : (real * real) =
  let
    val lat_min = 21.9945
    val lat_max = 22.0005
    val lon_min = 100.4950
    val lon_max = 100.5200

    val key_params = (rfid ^ &quot;#RE&quot;, pickupplan_id)   (* RE = Register -&gt; Empty *)
    val key_state  = (rfid, pickupplan_id)           

  
    val dir_lat = lat_max - lat_min
    val dir_lon = lon_max - lon_min
    val norm    = Math.sqrt(dir_lat * dir_lat + dir_lon * dir_lon)

    val params as (step_sz, _, _, _, _, _, _) = get_trip_params (key_params, norm)

    val current_t =
      case List.find (fn (k, _) =&gt; k = key_state) (!rfid_register_empty_list) of
          SOME (_, t0) =&gt; t0
        | NONE         =&gt; 0.0

    val new_t = if current_t &gt;= 1.0 then 1.0 else Real.min(1.0, current_t + step_sz)

    val _ =
      rfid_register_empty_list :=
        (key_state, new_t) :: List.filter (fn (k, _) =&gt; k &lt;&gt; key_state) (!rfid_register_empty_list)

    val (lat, lon) =
      if current_t = 0.0 then
        (lat_min, lon_min)
      else if new_t &gt;= 1.0 then
        (lat_max, lon_max)
      else
        generateGPS_with_params (new_t, lat_min, lat_max, lon_min, lon_max, params)
  in
    (lat, lon)
  end
