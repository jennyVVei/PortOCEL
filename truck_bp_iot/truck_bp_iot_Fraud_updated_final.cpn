        <ml id="ID1432742773">fun assignTWPerPP (nof_trs, weightPP) =
    let
        val totalWeight = weightPP
        val avgWeight = totalWeight / Real.fromInt(nof_trs)
        val minRandom = avgWeight - 120.0
        val maxRandom = avgWeight + 120.0
        val randomWeight = real(round((uniform(minRandom, maxRandom)) * 10.0))/10.0

        val assignedWeight =
            if nof_trs = 1 then totalWeight
            else if nof_trs &gt;= 2 then randomWeight  
            else 0.0
    in
        assignedWeight
    end;
          <layout>fun assignTWPerPP (nof_trs, weightPP) =
    let
        val totalWeight = weightPP
        val avgWeight = totalWeight / Real.fromInt(nof_trs)
        val minRandom = avgWeight - 120.0
        val maxRandom = avgWeight + 120.0
        val randomWeight = real(round((uniform(minRandom, maxRandom)) * 10.0))/10.0

        val assignedWeight =
            if nof_trs = 1 then totalWeight
            else if nof_trs &gt;= 2 then randomWeight  
            else 0.0
    in
        assignedWeight
    end;</layout>
        </ml>
