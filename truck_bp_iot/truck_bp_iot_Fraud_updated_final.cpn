            <ml id="ID1476244178">fun generateEmptyWeightoSiloGPS (): (real * real) =
  let
    val lat_min = 22.0100
    val lat_max = 22.0300
    val lon_min = 100.5200
    val lon_max = 100.5450  

    val randomNum = floor(uniform(1.0,100.0))

    fun generateValidGPS () =
      let
        val lat = real(round(uniform(lat_min, lat_max) * 10000.0)) / 10000.0
        val lon = real(round(uniform(lon_min, lon_max) * 10000.0)) / 10000.0
      in
        (lat, lon)
      end

    fun generateInvalidGPS () =
      let
        val i = floor(uniform(1.0,2.0))
        val p = uniform(0.0, 1.0) 
        val lat =
          if i =1 then lat_min - (p * 0.01) 
          else lat_max + (p * 0.01) 

        val lon =
          if i =1 then lon_min - (p* 0.01) 
          else lon_max + (p * 0.01) 
      in
        (real(round(lat * 10000.0)) / 10000.0, real(round(lon * 10000.0)) / 10000.0)
      end
  in
    if randomNum &lt;= 5 then generateInvalidGPS ()
    else generateValidGPS ()
  end;
