      <block id="ID1439726999">
        <id>Environmental sensor data extraction</id>
        <ml id="ID1440759523">fun disassembleTimestamp (timestamp: string) : (string * int) =
    let
        (* Split the timestamp into date and time parts *)
        val parts = String.tokens (fn c =&gt; c = #&quot; &quot;) timestamp
        val datePart = List.nth(parts, 0)
        val timePart = List.nth(parts, 1)

        (* Split the time part to get the hour *)
        val timeParts = String.tokens (fn c =&gt; c = #&quot;:&quot;) timePart
        val hour = valOf (Int.fromString (List.nth(timeParts, 0)))
    in
        (datePart, hour)
    end;
          <layout>fun disassembleTimestamp (timestamp: string) : (string * int) =
    let
        (* Split the timestamp into date and time parts *)
        val parts = String.tokens (fn c =&gt; c = #&quot; &quot;) timestamp
        val datePart = List.nth(parts, 0)
        val timePart = List.nth(parts, 1)

        (* Split the time part to get the hour *)
        val timeParts = String.tokens (fn c =&gt; c = #&quot;:&quot;) timePart
        val hour = valOf (Int.fromString (List.nth(timeParts, 0)))
    in
        (datePart, hour)
    end;</layout>
        </ml>
