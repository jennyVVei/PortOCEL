                                SOME r =&gt; r 
                              | NONE =&gt; 0.0) :: extractRow rest
                | _ =&gt; extractRow rest
    in
        extractRow (List.tl data) (* Skip header row *)
    end;</layout>
        </ml>
        <ml id="ID1475508700">fun getRainfallCondition (tr_id, inputDate, inputHour) =
    let
        (* Read the CSV file into a list of (date, rainfall_mm) tuples *)
        val rainfall_data = extractRainfall (readCSV(&quot;../hourly_rainfall_data.csv&quot;))

        (* Function to find the rainfall amount for the given inputDate and inputHour *)
        fun findRainfall [] = NONE
          | findRainfall ((timestamp, rainfall_mm) :: rest) =
              let
                  val (rainfall_date, rainfall_hour) = disassembleTimestamp timestamp
              in
                  if rainfall_date = inputDate andalso rainfall_hour = inputHour
                  then SOME rainfall_mm
                  else findRainfall rest
              end

        (* Get the rainfall value if found *)
        val rainfall_result = findRainfall rainfall_data

        (* Determine rainfall condition *)
        val rain_condition = case rainfall_result of
                                SOME mm =&gt; if mm &gt;= 2.0 then &quot;Have Rain&quot; else &quot;No Rain&quot;
                              | NONE =&gt; &quot;No Data&quot;  (* In case inputDate &amp; inputHour are not found *)
    in
        (tr_id, rain_condition)
    end;
          <layout>fun getRainfallCondition (tr_id, inputDate, inputHour) =
    let
        (* Read the CSV file into a list of (date, rainfall_mm) tuples *)
        val rainfall_data = extractRainfall (readCSV(&quot;../hourly_rainfall_data.csv&quot;))

        (* Function to find the rainfall amount for the given inputDate and inputHour *)
        fun findRainfall [] = NONE
          | findRainfall ((timestamp, rainfall_mm) :: rest) =
              let
                  val (rainfall_date, rainfall_hour) = disassembleTimestamp timestamp
              in
                  if rainfall_date = inputDate andalso rainfall_hour = inputHour
                  then SOME rainfall_mm
                  else findRainfall rest
              end

        (* Get the rainfall value if found *)
        val rainfall_result = findRainfall rainfall_data

        (* Determine rainfall condition *)
        val rain_condition = case rainfall_result of
                                SOME mm =&gt; if mm &gt;= 2.0 then &quot;Have Rain&quot; else &quot;No Rain&quot;
                              | NONE =&gt; &quot;No Data&quot;  (* In case inputDate &amp; inputHour are not found *)
    in
        (tr_id, rain_condition)
    end;</layout>
        </ml>
      </block>
