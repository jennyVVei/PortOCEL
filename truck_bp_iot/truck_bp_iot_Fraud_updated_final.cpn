        <ml id="ID1436439270">fun event_map_type(a: EventType) = 
if a=&quot;Lodge Pickup Plan&quot; then &quot;LodgePickupPlan&quot; else 
if a=&quot;Assess Pickup Plan&quot; then &quot;AssessPickupPlan&quot; else
if a=&quot;Approve Pickup Plan&quot; then &quot;ApprovePickupPlan&quot; else
if a=&quot;Reject Pickup Plan&quot; then &quot;RejectPickupPlan&quot; else
if a=&quot;Assign Truck&quot; then &quot;AssignTruck&quot; else
if a=&quot;Enter the port&quot; then &quot;Enterport&quot; else
if a=&quot;Register the truck arrival&quot; then &quot;RegisterTruckArrival&quot; else
if a=&quot;Weigh the Empty Truck&quot; then &quot;WeighEmptyTruck&quot; else
if a=&quot;Check Empty Truck Weight Abnormality&quot; then &quot;CheckEmptyTruckWeightAbnormality&quot; else
if a=&quot;Fail to Weigh&quot; then &quot;FailtoWeigh&quot; else
if a=&quot;Arrive at the Silo&quot; then &quot;ArriveatSilo&quot; else
if a=&quot;Determine the Continuance of the Pickup&quot; then &quot;DetermineContinuanceofPickup&quot; else
if a=&quot;Fail to Load&quot; then &quot;FailtoLoad&quot; else
if a=&quot;Load Truck&quot; then &quot;LoadTruck&quot; else
if a=&quot;Weigh the Loaded Truck&quot; then &quot;WeighLoadedTruck&quot; else
if a=&quot;Input the Tally Sheet&quot; then &quot;InputTallySheet&quot; else
if a=&quot;Issue the Weighing Ticket&quot; then &quot;IssueWeighingTicket&quot; else
if a=&quot;Evaluate the Truck Exit&quot; then &quot;EvaluateTruckExit&quot; else
if a=&quot;Detain at the port&quot; then &quot;DetainAtPort&quot; else
if a=&quot;Exit the port&quot; then &quot;ExitPort&quot; else
&quot;&quot;;
