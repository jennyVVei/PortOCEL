        <block id="ID1441463718">
          <id>Adjust date</id>
          <ml id="ID1441463284">fun isLeapYear year =
    (year mod 4 = 0 andalso year mod 100 &lt;&gt; 0) orelse (year mod 400 = 0)
            <layout>(* Check if a year is a leap year *)
fun isLeapYear year =
    (year mod 4 = 0 andalso year mod 100 &lt;&gt; 0) orelse (year mod 400 = 0)</layout>
          </ml>
          <ml id="ID1442171598">fun daysInMonth (year, month) =
    case month of
         1 =&gt; 31
       | 2 =&gt; if isLeapYear year then 29 else 28
       | 3 =&gt; 31
       | 4 =&gt; 30
       | 5 =&gt; 31
       | 6 =&gt; 30
       | 7 =&gt; 31
       | 8 =&gt; 31
       | 9 =&gt; 30
       | 10 =&gt; 31
       | 11 =&gt; 30
       | 12 =&gt; 31
       | _ =&gt; raise Fail &quot;Invalid month&quot;
            <layout>(* Get the number of days in a given month of a specific year *)
fun daysInMonth (year, month) =
    case month of
         1 =&gt; 31
       | 2 =&gt; if isLeapYear year then 29 else 28
       | 3 =&gt; 31
       | 4 =&gt; 30
       | 5 =&gt; 31
       | 6 =&gt; 30
       | 7 =&gt; 31
       | 8 =&gt; 31
       | 9 =&gt; 30
       | 10 =&gt; 31
       | 11 =&gt; 30
       | 12 =&gt; 31
       | _ =&gt; raise Fail &quot;Invalid month&quot;</layout>
          </ml>
          <ml id="ID1441465176">fun adjustDate (year, month, day, days) =
            let
                val newDay = day + days
                val daysInCurrentMonth = daysInMonth(year, month)
            in
                if newDay &gt; 0 andalso newDay &lt;= daysInCurrentMonth then
                    (year, month, newDay)
                else if newDay &gt; daysInCurrentMonth then
                    if month = 12 then
                        adjustDate (year + 1, 1, newDay - daysInCurrentMonth, 0)
                    else
                        adjustDate (year, month + 1, newDay - daysInCurrentMonth, 0)
                else
                    if month = 1 then
                        adjustDate (year - 1, 12, newDay + daysInMonth(year - 1, 12), 0)
                    else
                        adjustDate (year, month - 1, newDay + daysInMonth(year, month - 1), 0)
            end
            <layout>fun adjustDate (year, month, day, days) =
            let
                val newDay = day + days
                val daysInCurrentMonth = daysInMonth(year, month)
            in
                if newDay &gt; 0 andalso newDay &lt;= daysInCurrentMonth then
                    (year, month, newDay)
                else if newDay &gt; daysInCurrentMonth then
                    if month = 12 then
                        adjustDate (year + 1, 1, newDay - daysInCurrentMonth, 0)
                    else
                        adjustDate (year, month + 1, newDay - daysInCurrentMonth, 0)
                else
                    if month = 1 then
                        adjustDate (year - 1, 12, newDay + daysInMonth(year - 1, 12), 0)
                    else
                        adjustDate (year, month - 1, newDay + daysInMonth(year, month - 1), 0)
            end</layout>
          </ml>
          <ml id="ID1441467298">fun padLeft(s, width) =
    let
        val len = String.size s
    in
        if len &gt;= width then s
        else String.concat (List.tabulate (width - len, fn _ =&gt; &quot;0&quot;)) ^ s
    end
            <layout>fun padLeft(s, width) =
    let
        val len = String.size s
    in
        if len &gt;= width then s
        else String.concat (List.tabulate (width - len, fn _ =&gt; &quot;0&quot;)) ^ s
    end</layout>
          </ml>
          <ml id="ID1441464491">fun addDays(dateStr, days) =
    let
        val year = valOf (Int.fromString (String.substring(dateStr, 0, 4)))
        val month = valOf (Int.fromString (String.substring(dateStr, 5, 2)))
        val day = valOf (Int.fromString (String.substring(dateStr, 8, 2)))
        
        val (newYear, newMonth, newDay) = adjustDate (year, month, day, days)
    in
        padLeft(Int.toString newYear, 4) ^ &quot;-&quot; ^
        padLeft(Int.toString newMonth, 2) ^ &quot;-&quot; ^
        padLeft(Int.toString newDay, 2)
    end;
            <layout>fun addDays(dateStr, days) =
    let
        val year = valOf (Int.fromString (String.substring(dateStr, 0, 4)))
        val month = valOf (Int.fromString (String.substring(dateStr, 5, 2)))
        val day = valOf (Int.fromString (String.substring(dateStr, 8, 2)))
        
        val (newYear, newMonth, newDay) = adjustDate (year, month, day, days)
    in
        padLeft(Int.toString newYear, 4) ^ &quot;-&quot; ^
        padLeft(Int.toString newMonth, 2) ^ &quot;-&quot; ^
        padLeft(Int.toString newDay, 2)
    end;</layout>
          </ml>
          <ml id="ID1441464824">fun adjustDateAndSetHour(dateStr, days, hour) =
    let
        val newDate = addDays(dateStr, days)
    in
        (newDate, hour)
    end;
            <layout>(* Function to adjust the date and set the hour *)
