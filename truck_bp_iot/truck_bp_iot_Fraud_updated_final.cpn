              let
                  val mw = case Real.fromString manufactured_weight of NONE =&gt; 0.0 | SOME realVal =&gt; realVal
                  val lbmw = case Real.fromString last_but_one_empty_weight of NONE =&gt; 0.0 | SOME realVal =&gt; realVal
