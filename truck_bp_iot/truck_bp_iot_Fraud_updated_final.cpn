        <ml id="ID1431527997">fun write_lodge_pp(pp_id, cr_id, totalWeight) =
let
val maxtrLoad = 6000.0
val date = t2s(now())
val nof_trs = divideAndGetQuotient (totalWeight, maxtrLoad)
val event_id = &quot;lodge_&quot;^pp_id 
val event_order = [[event_id, pp_id, &quot;lodged pickup plan&quot;]]
val e2o_relations = event_order
val event_cargo = [[event_id, cr_id, &quot;cargo to be picked up&quot;]]
val e2o_relation1 = event_cargo
val pp_cargo = [[pp_id, cr_id, &quot;Lodged pickup plan for cargo&quot;,date]]
val o2o_relations = pp_cargo
in
(
write_event(event_id, &quot;Lodge Pickup Plan&quot;, []);
initialize_PP(pp_id, cr_id, nof_trs, totalWeight);
write_e2o_relations(e2o_relations);
write_e2o_relations(e2o_relation1);
write_o2o_relations(o2o_relations);
nof_trs
)
end;
