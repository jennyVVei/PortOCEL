        <ml id="ID1456636250">fun parseDateTime (timestamp: string) : (int * int * int * int * int * int) =
    let
        (* Split the timestamp into date and time parts *)
        val parts = String.tokens (fn c =&gt; c = #&quot; &quot;) timestamp
        val datePart = List.nth(parts, 0)
        val timePart = List.nth(parts, 1)

        (* Split the date part *)
        val dateParts = String.tokens (fn c =&gt; c = #&quot;-&quot;) datePart
        val year = case Int.fromString (List.nth(dateParts, 0)) of SOME y =&gt; y | NONE =&gt; raise Fail &quot;Invalid year&quot;
        val month = case Int.fromString (List.nth(dateParts, 1)) of SOME m =&gt; m | NONE =&gt; raise Fail &quot;Invalid month&quot;
        val day = case Int.fromString (List.nth(dateParts, 2)) of SOME d =&gt; d | NONE =&gt; raise Fail &quot;Invalid day&quot;

        (* Split the time part *)
        val timeParts = String.tokens (fn c =&gt; c = #&quot;:&quot;) timePart
        val hour = case Int.fromString (List.nth(timeParts, 0)) of SOME h =&gt; h | NONE =&gt; raise Fail &quot;Invalid hour&quot;
        val minute = case Int.fromString (List.nth(timeParts, 1)) of SOME min =&gt; min | NONE =&gt; raise Fail &quot;Invalid minute&quot;
        val second = case Int.fromString (List.nth(timeParts, 2)) of SOME sec =&gt; sec | NONE =&gt; raise Fail &quot;Invalid second&quot;
    in
        (year, month, day, hour, minute, second)
    end;
          <layout>fun parseDateTime (timestamp: string) : (int * int * int * int * int * int) =
    let
        (* Split the timestamp into date and time parts *)
        val parts = String.tokens (fn c =&gt; c = #&quot; &quot;) timestamp
        val datePart = List.nth(parts, 0)
        val timePart = List.nth(parts, 1)

        (* Split the date part *)
        val dateParts = String.tokens (fn c =&gt; c = #&quot;-&quot;) datePart
        val year = case Int.fromString (List.nth(dateParts, 0)) of SOME y =&gt; y | NONE =&gt; raise Fail &quot;Invalid year&quot;
        val month = case Int.fromString (List.nth(dateParts, 1)) of SOME m =&gt; m | NONE =&gt; raise Fail &quot;Invalid month&quot;
        val day = case Int.fromString (List.nth(dateParts, 2)) of SOME d =&gt; d | NONE =&gt; raise Fail &quot;Invalid day&quot;

        (* Split the time part *)
        val timeParts = String.tokens (fn c =&gt; c = #&quot;:&quot;) timePart
        val hour = case Int.fromString (List.nth(timeParts, 0)) of SOME h =&gt; h | NONE =&gt; raise Fail &quot;Invalid hour&quot;
        val minute = case Int.fromString (List.nth(timeParts, 1)) of SOME min =&gt; min | NONE =&gt; raise Fail &quot;Invalid minute&quot;
        val second = case Int.fromString (List.nth(timeParts, 2)) of SOME sec =&gt; sec | NONE =&gt; raise Fail &quot;Invalid second&quot;
    in
        (year, month, day, hour, minute, second)
    end;</layout>
        </ml>
        <ml id="ID1456649205">fun toTotalSeconds (year: int, month: int, day: int, hour: int, minute: int, second: int) =
    let
        val daysInMonths = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]

        (* Check if the year is a leap year *)
        fun isLeapYear y = (y mod 4 = 0 andalso (y mod 100 &lt;&gt; 0 orelse y mod 400 = 0))

        (* Total days from the start of the year *)
        val daysInYear = List.foldl (op +) 0 (List.take (daysInMonths, month - 1)) + day
        val leapDayAdjustment = if isLeapYear year andalso month &gt; 2 then 1 else 0

        (* Convert year-based calculations to seconds *)
        val totalDays = daysInYear + leapDayAdjustment
        val totalSecondsFromYearStart = totalDays * 24 * 3600

        (* Add the time-based seconds *)
        val totalTimeInSeconds = (hour * 3600) + (minute * 60) + second

    in
        (* Combine days and time *)
        totalSecondsFromYearStart + totalTimeInSeconds
    end;
          <layout>fun toTotalSeconds (year: int, month: int, day: int, hour: int, minute: int, second: int) =
    let
        val daysInMonths = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]

        (* Check if the year is a leap year *)
        fun isLeapYear y = (y mod 4 = 0 andalso (y mod 100 &lt;&gt; 0 orelse y mod 400 = 0))

        (* Total days from the start of the year *)
        val daysInYear = List.foldl (op +) 0 (List.take (daysInMonths, month - 1)) + day
        val leapDayAdjustment = if isLeapYear year andalso month &gt; 2 then 1 else 0

        (* Convert year-based calculations to seconds *)
        val totalDays = daysInYear + leapDayAdjustment
        val totalSecondsFromYearStart = totalDays * 24 * 3600

        (* Add the time-based seconds *)
        val totalTimeInSeconds = (hour * 3600) + (minute * 60) + second

    in
        (* Combine days and time *)
        totalSecondsFromYearStart + totalTimeInSeconds
    end;</layout>
        </ml>
        <ml id="ID1456566697">fun hourDifference_old (date1: string, date2: string) : int =
    let
       val (year1, month1, day1, hour1, minute1, second1) = parseDateTime(date1)
       val (year2, month2, day2, hour2, minute2, second2) = parseDateTime(date2)

       val totalSeconds1 = toTotalSeconds (year1, month1, day1, hour1, minute1, second1)
       val totalSeconds2 = toTotalSeconds (year2, month2, day2, hour2, minute2, second2)

       (* Calculate absolute difference in seconds *)
       val secondsDiff = abs(totalSeconds1 - totalSeconds2)
       val hourDiff = round((Real.fromInt secondsDiff*1.0)/3600.0)
       
   in
       hourDiff
end
          <layout>fun hourDifference_old (date1: string, date2: string) : int =
    let
       val (year1, month1, day1, hour1, minute1, second1) = parseDateTime(date1)
       val (year2, month2, day2, hour2, minute2, second2) = parseDateTime(date2)

       val totalSeconds1 = toTotalSeconds (year1, month1, day1, hour1, minute1, second1)
       val totalSeconds2 = toTotalSeconds (year2, month2, day2, hour2, minute2, second2)

       (* Calculate absolute difference in seconds *)
       val secondsDiff = abs(totalSeconds1 - totalSeconds2)
       val hourDiff = round((Real.fromInt secondsDiff*1.0)/3600.0)
       
   in
       hourDiff
end</layout>
        </ml>
      </block>
      <block id="ID1425234312">
        <id>ReadCSVs</id>
        <ml id="ID1425235423">fun readCSV(file_id: string): string list list =
let
        val infile = TextIO.openIn file_id
        val lines = TextIO.inputAll infile
        val rows = String.tokens (fn c =&gt; c = #&quot;\n&quot;) lines
        val csvData = List.map (fn row =&gt; String.tokens (fn c =&gt; c = #&quot;,&quot;) row) rows
in
        TextIO.closeIn infile;
        csvData
end handle _ =&gt; [];
          <layout>fun readCSV(file_id: string): string list list =
let
        val infile = TextIO.openIn file_id
        val lines = TextIO.inputAll infile
        val rows = String.tokens (fn c =&gt; c = #&quot;\n&quot;) lines
        val csvData = List.map (fn row =&gt; String.tokens (fn c =&gt; c = #&quot;,&quot;) row) rows
in
        TextIO.closeIn infile;
        csvData
end handle _ =&gt; [];</layout>
        </ml>
