          <ml id="ID1462400805">fun update_table (rfid, current_empty_weight) =
  let
    (* File path *)
    val file = &quot;./TruckHistoryWeightRecord.csv&quot;

    (* Read the current table from the file *)
    val table = read_table file

    val i = round(uniform(1.0, 100.0))

    (* Check if the RFID record already exists *)
    val maybe_existing = List.find (fn (id, _) =&gt; id = rfid) table

    (* Updated table logic *)
    val (avg_weight, updated_table) =
      case maybe_existing of
          NONE =&gt;
            if i &lt;= 8 then
              let
                val manufactured_weight = current_empty_weight - real(round(uniform(200.0, 250.0)*10.0))/10.0
                val avg_weight = manufactured_weight 
                val new_record = {average_weight = avg_weight, manufactured_weight = manufactured_weight, empty_weights = [current_empty_weight]}
              in
                (avg_weight, (rfid, new_record) :: table)
              end
            else
              let
                val manufactured_weight = current_empty_weight - real(round(uniform(50.0,99.0)*10.0))/10.0
                val avg_weight = manufactured_weight
                val new_record = {average_weight = avg_weight, manufactured_weight = manufactured_weight, empty_weights = [current_empty_weight]}
              in
                (avg_weight, (rfid, new_record) :: table)
              end
        | SOME (id, {average_weight, manufactured_weight, empty_weights}) =&gt;
            (* If the RFID exists, append the new weight to the end of the list *)
            let
              val avg_weight = 0.55* manufactured_weight + 0.45*(calculate_history_empty empty_weights)
              val updated_weights = List.rev (current_empty_weight :: List.rev empty_weights)
              val updated_record = {average_weight = avg_weight, manufactured_weight = manufactured_weight, empty_weights = updated_weights}
            in
              (avg_weight, List.map (fn (other_id, record) =&gt;
                          if other_id = rfid then
                            (rfid, updated_record)  (* Update the matching record *)
                          else
                            (other_id, record))  (* Keep other records unchanged *)
                       table)
            end
          (* Write the updated table back to the file *)
          val _ =  write_table file updated_table
  in
    (* Return the RFID and a confirmation message *)
    (rfid, avg_weight)
  end;
            <layout>fun update_table (rfid, current_empty_weight) =
  let
    (* File path *)
