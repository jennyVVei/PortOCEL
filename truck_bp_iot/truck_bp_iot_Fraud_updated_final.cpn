  let
    val lat_min = 21.9900
    val lat_max = 21.9950
    val lon_min = 100.5200
    val lon_max = 100.5300
    val key = (rfid, pickupplan_id)

    val current_t =
      case List.find (fn (k, _) =&gt; k = key) (!rfid_loaded_exit_list) of
        SOME (_, t0) =&gt; t0
      | NONE =&gt; 0.0

 
    val new_t = if current_t &gt;= 1.0 then 1.0 else current_t + step_size

 
    val _ = rfid_loaded_exit_list := (key, new_t) :: List.filter (fn (k, _) =&gt; k &lt;&gt; key) (!rfid_loaded_exit_list)

    val (lat, lon) =
