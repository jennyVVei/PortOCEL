          <ml id="ID1451367294">fun randomFactor() = real(round(uniform(~5.0,0.1)))/100.0
            <layout>fun randomFactor() = real(round(uniform(~5.0,0.1)))/100.0</layout>
          </ml>
          <ml id="ID1462415210">fun calculate_manufactured_weight(empty_weight) = empty_weight + (empty_weight * randomFactor())
            <layout>fun calculate_manufactured_weight(empty_weight) = empty_weight + (empty_weight * randomFactor())</layout>
