    let
        val newDate = addDays(dateStr, days)
    in
        (newDate, hour)
    end;</layout>
          </ml>
        </block>
        <block id="ID1441534713">
          <id>getEnvData</id>
          <ml id="ID1449249318">fun getGrainTemp (siloID, inputDate, inputHour,extractedData) =
    let
        (* Read and extract environmental data from CSV *)
        val extractedData = extractEnvData(readCSV(&quot;../Reshaped_Silo_IoT_Data_with_dewpoint_prob.csv&quot;))

        (* Adjust the input date and hour based on specified rules *)
        fun adjustDateHour(date,hour) =
            if hour &lt; 8 then
                adjustDateAndSetHour(date, ~1, 17)
            else if hour &gt; 17 then
                adjustDateAndSetHour(date, 0, 17)
            else
                adjustDateAndSetHour(date, 0, hour)

        val (relevantDate, relevantHour) = adjustDateHour(inputDate, inputHour)

        (* Find the matching row based on siloID, relevant date, and relevant hour *)
        val matchingRow = List.find (fn (silo, date, hour, _, _, _, _, _, _, gtemp1, gtemp1ID, gtemp2, gtemp2ID, gtemp3, gtemp3ID) =&gt; 
silo = siloID andalso date = relevantDate andalso hour = relevantHour) extractedData

        (* Function to calculate the average of three grain temperatures *)
        fun averageGrainTemp (gtemp1, gtemp2, gtemp3) = real(round(((gtemp1 + gtemp2 + gtemp3) / 3.0) * 10.0)) / 10.0
    in
        (* Return average grain temperature and temperature sensor IDs or default values if no matching row is found *)
        case matchingRow of
             NONE =&gt; (0.0, &quot;null&quot;, &quot;null&quot;, &quot;null&quot;)  (* Return default value if no matching row found *)
           | SOME (_, _, _, _, _, _, _, _, _, gtemp1, gtemp1ID, gtemp2, gtemp2ID, gtemp3, gtemp3ID) =&gt;
               (averageGrainTemp(gtemp1, gtemp2, gtemp3), gtemp1ID, gtemp2ID, gtemp3ID)
    end
            <layout>fun getGrainTemp (siloID, inputDate, inputHour,extractedData) =
    let
