          <ml id="ID1462630102">fun read_table file =
      let
        val inStream = TextIO.openIn(file)
        val _ = TextIO.inputLine inStream
        val table = read_truckEWeightHistory_lines inStream []
        val _ = TextIO.closeIn(inStream)
      in
        table
      end;
