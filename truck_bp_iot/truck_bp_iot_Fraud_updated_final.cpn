        <block id="ID1468736087">
          <id>RecordGPSData</id>
          <ml id="ID1477312189">val step_size= uniform(0.02, 0.065)
            <layout>val step_size= uniform(0.02, 0.065)</layout>
          </ml>
          <ml id="ID1477312011">fun generateGPS(t: real, lat_min: real, lat_max: real, lon_min: real, lon_max: real) : (real * real) =
  let
    val direction_lat = lat_max - lat_min
    val direction_lon = lon_max - lon_min
    val norm = Math.sqrt(direction_lat * direction_lat + direction_lon * direction_lon)
    val unit_lat = direction_lat / norm
    val unit_lon = direction_lon / norm

    val ortho_lat = ~unit_lon
    val ortho_lon = unit_lat

    
    val bias = uniform(0.0,1.0)
    val center1 = 0.3 + bias * 0.25 
    val center2 = 0.6 + bias * 0.25 

    val base_lat = lat_min + t * direction_lat
    val base_lon = lon_min + t * direction_lon

    fun generate_valid_point () =
      let
        val wave_sign = if uniform(1.0,100.0) &lt; 50.0 then ~1.0 else 1.0
        val noise = 0.00035 * uniform(~1.0, 1.0)
        val wave =
           wave_sign * (1.0 - t)*
          (0.0016 * (gaussian(t, center1, 0.02) + 2.0 * gaussian(t, center2, 0.015))
           + noise)

        val dev_lat = base_lat + wave * ortho_lat
        val dev_lon = base_lon + wave * ortho_lon
      in
        if lat_min &lt; dev_lat andalso dev_lat &lt; lat_max andalso
           lon_min &lt; dev_lon andalso dev_lon &lt; lon_max
        then (dev_lat, dev_lon)
        else generate_valid_point ()
      end

     val (lat, lon) = if t &gt; 0.0 andalso t &lt; 1.0 then
             generate_valid_point()
    else if t &lt;= 0.0 then
         (lat_min, lon_min)
    else  
        (lat_max, lon_max)

    val lat_rounded = real(round(lat * 10000.0)) / 10000.0
    val lon_rounded = real(round(lon * 10000.0)) / 10000.0
  in
    (lat_rounded, lon_rounded)
  end
            <layout>fun generateGPS(t: real, lat_min: real, lat_max: real, lon_min: real, lon_max: real) : (real * real) =
  let
    val direction_lat = lat_max - lat_min
    val direction_lon = lon_max - lon_min
    val norm = Math.sqrt(direction_lat * direction_lat + direction_lon * direction_lon)
    val unit_lat = direction_lat / norm
    val unit_lon = direction_lon / norm

    val ortho_lat = ~unit_lon
    val ortho_lon = unit_lat

    
    val bias = uniform(0.0,1.0)
    val center1 = 0.3 + bias * 0.25 
    val center2 = 0.6 + bias * 0.25 

    val base_lat = lat_min + t * direction_lat
    val base_lon = lon_min + t * direction_lon

    fun generate_valid_point () =
      let
        val wave_sign = if uniform(1.0,100.0) &lt; 50.0 then ~1.0 else 1.0
        val noise = 0.00035 * uniform(~1.0, 1.0)
        val wave =
           wave_sign * (1.0 - t)*
          (0.0016 * (gaussian(t, center1, 0.02) + 2.0 * gaussian(t, center2, 0.015))
           + noise)

        val dev_lat = base_lat + wave * ortho_lat
        val dev_lon = base_lon + wave * ortho_lon
      in
        if lat_min &lt; dev_lat andalso dev_lat &lt; lat_max andalso
           lon_min &lt; dev_lon andalso dev_lon &lt; lon_max
        then (dev_lat, dev_lon)
        else generate_valid_point ()
      end

     val (lat, lon) = if t &gt; 0.0 andalso t &lt; 1.0 then
             generate_valid_point()
    else if t &lt;= 0.0 then
         (lat_min, lon_min)
    else  
        (lat_max, lon_max)

    val lat_rounded = real(round(lat * 10000.0)) / 10000.0
    val lon_rounded = real(round(lon * 10000.0)) / 10000.0
  in
    (lat_rounded, lon_rounded)
  end</layout>
          </ml>
          <ml id="ID1481474632">val trip_params :
  (((string * string) * (real * real * real * real * real * real * real)) list) ref = ref [];
            <layout>val trip_params :
  (((string * string) * (real * real * real * real * real * real * real)) list) ref = ref [];</layout>
