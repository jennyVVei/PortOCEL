            <ml id="ID1477571091">fun step_rfid_position_empty_to_silo(rfid: string, pickupplan_id: string) : (real * real) =
  let
    val lat_min = 22.0150
    val lat_max = 22.0300
    val lon_min = 100.5250
    val lon_max = 100.5500 
    val key = (rfid, pickupplan_id)

    val current_t =
      case List.find (fn (k, _) =&gt; k = key) (!rfid_empty_silo_list) of
        SOME (_, t0) =&gt; t0
      | NONE =&gt; 0.0

 
    val new_t = if current_t &gt;= 1.0 then 1.0 else current_t + step_size

 
    val _ = rfid_empty_silo_list := (key, new_t) :: List.filter (fn (k, _) =&gt; k &lt;&gt; key) (!rfid_empty_silo_list)

    val (lat, lon) =
