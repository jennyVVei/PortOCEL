          <ml id="ID1462644925">fun read_truckEWeightHistory_lines inputStream acc=
       case TextIO.inputLine inputStream of
           NONE =&gt; acc 
         | SOME line =&gt;
             let
               val fields = String.tokens (fn c =&gt; c = #&quot;,&quot;) line
               val rfid = List.nth (fields, 0)  
               val avg_weight =
                   case Real.fromString (List.nth (fields, 2)) of
                        NONE =&gt; raise Fail &quot;Invalid average weight&quot;
                     | SOME aw =&gt; aw  
               val manufactured_weight =
                   case Real.fromString (List.nth (fields, 1)) of
                       NONE =&gt; raise Fail &quot;Invalid manufactured weight&quot;
                     | SOME mw =&gt; mw
               val empty_weights =
                   let
                     val weight_strings = String.tokens (fn c =&gt; c = #&quot;,&quot;) (List.nth (fields, 3))
                   in
                     List.map (fn s =&gt;
                            case Real.fromString s of
                                NONE =&gt; raise Fail &quot;Invalid empty weight&quot;
                              | SOME ew =&gt; ew)  (List.drop (fields, 3))
                   end
             in
               read_truckEWeightHistory_lines inputStream ((rfid, {average_weight = avg_weight, manufactured_weight = manufactured_weight, empty_weights = empty_weights}) :: acc)
             end;
