        <ml id="ID1436442306">fun write_event_map_types(file_id, []) = () | write_event_map_types(file_id, et::ets) = (TextIO.output(file_id, list2string([et, event_map_type(et)])); TextIO.output(file_id, &quot;\n&quot;); write_event_map_types(file_id, ets)) 

