        <ml id="ID1436443078">fun copyFile (sourcePath : string, destPath : string) =
let
    val inFile = TextIO.openIn sourcePath
    val outFile = TextIO.openOut destPath
    fun copy (inStream, outStream) =
    case TextIO.inputLine inStream of
        NONE =&gt; ()
    | SOME line =&gt;
        (TextIO.output (outStream, line);
            copy (inStream, outStream))
in
    copy (inFile, outFile);
    TextIO.closeIn inFile;
    TextIO.closeOut outFile
end;
          <layout>fun copyFile (sourcePath : string, destPath : string) =
let
    val inFile = TextIO.openIn sourcePath
    val outFile = TextIO.openOut destPath
    fun copy (inStream, outStream) =
    case TextIO.inputLine inStream of
        NONE =&gt; ()
    | SOME line =&gt;
        (TextIO.output (outStream, line);
            copy (inStream, outStream))
in
    copy (inFile, outFile);
    TextIO.closeIn inFile;
    TextIO.closeOut outFile
end;</layout>
        </ml>
