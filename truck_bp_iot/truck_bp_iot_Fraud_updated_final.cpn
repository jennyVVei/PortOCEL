          <ml id="ID1462724421">fun write_table file table =
  let
    val outStream = TextIO.openOut file
    val _ = TextIO.output (outStream, &quot;RFID tag, Average Weight, Manufactured Weight, Empty Weights\n&quot;)
    val _ = List.app (fn (id, {average_weight, manufactured_weight, empty_weights}) =&gt;
                        TextIO.output (outStream,
                          id ^ &quot;,&quot; ^ Real.toString average_weight ^ &quot;,&quot; ^ Real.toString manufactured_weight ^ &quot;,&quot; ^
                          String.concatWith &quot;,&quot; (List.map Real.toString empty_weights) ^ &quot;\n&quot;))
                     table
    val _ = TextIO.closeOut outStream
  in
    ()
  end
            <layout>fun write_table file table =
  let
    val outStream = TextIO.openOut file
    val _ = TextIO.output (outStream, &quot;RFID tag, Average Weight, Manufactured Weight, Empty Weights\n&quot;)
    val _ = List.app (fn (id, {average_weight, manufactured_weight, empty_weights}) =&gt;
                        TextIO.output (outStream,
                          id ^ &quot;,&quot; ^ Real.toString average_weight ^ &quot;,&quot; ^ Real.toString manufactured_weight ^ &quot;,&quot; ^
                          String.concatWith &quot;,&quot; (List.map Real.toString empty_weights) ^ &quot;\n&quot;))
                     table
    val _ = TextIO.closeOut outStream
  in
    ()
  end</layout>
          </ml>
          <ml id="ID1462739412">fun calculate_average (manufactured_weight: real) (empty_weights: real list): real =
  let
    val total_sum = manufactured_weight + List.foldl op+ 0.0 empty_weights
    val total_count = 1 + List.length empty_weights
    val avg = total_sum / Real.fromInt(total_count)
  in
    avg
  end
            <layout>fun calculate_average (manufactured_weight: real) (empty_weights: real list): real =
  let
    val total_sum = manufactured_weight + List.foldl op+ 0.0 empty_weights
    val total_count = 1 + List.length empty_weights
    val avg = total_sum / Real.fromInt(total_count)
  in
    avg
  end</layout>
          </ml>
