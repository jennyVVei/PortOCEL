    if randomNum &lt;= 5 then generateInvalidGPS ()
    else generateValidGPS ()
  end;</layout>
            </ml>
            <ml id="ID1476245227">fun writeEmptyWeightoSiloGPSrecord (trid: string, ppid: string, rfid: string) =
  let
    val file = &quot;./TruckGPSRecord.csv&quot;
    val gpsID = &quot;GPS_&quot; ^ trid
    val date = t2s(now())
    val (lat, lon) = step_rfid_position_empty_to_silo_new (rfid,ppid)
    val record = gpsID ^ &quot;,&quot; ^ rfid ^ &quot;,&quot; ^ ppid ^ &quot;,&quot; ^ date ^ &quot;,&quot; ^
                 Real.toString lat ^ &quot;,&quot; ^ Real.toString lon ^ &quot;\n&quot;
    val file_id = TextIO.openAppend file
    val _ = TextIO.output(file_id, record)
  in
    TextIO.closeOut file_id;
    (gpsID, lat, lon)
  end;
