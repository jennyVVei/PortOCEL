          <ml id="ID1441512343">fun getEnvData (siloID, inputDate, inputHour) =
    let
        val extractedData = extractEnvData(readCSV(&quot;../Reshaped_Silo_IoT_Data_with_dewpoint_prob.csv&quot;))

        (*function to get temperature and humidity *)
        fun getTempHum (siloID, inputDate, inputHour) =
            let
                val relevantDateHour =
                    if inputHour &lt; 8 then
                        adjustDateAndSetHour(inputDate, ~1, 14)
                    else if inputHour &gt;= 8 andalso inputHour &lt; 14 then
                        adjustDateAndSetHour(inputDate, 0, 8)
                    else
                        adjustDateAndSetHour(inputDate, 0, 14)
                
                val relevantDate = #1 relevantDateHour
                val relevantHour = #2 relevantDateHour
                
                val matchingRow = List.find (fn (silo, date, hour, temp, tempID, humd, humdID, _, _, _, _,_,_,_,_) =&gt; silo = siloID andalso date = relevantDate andalso hour = relevantHour) extractedData
            in
                case matchingRow of
                     NONE =&gt; (0.0, &quot;null&quot;, 0.0, &quot;null&quot;)  (* Return default values if no matching row found *)
                   | SOME (_, _, _, temp, tempID, humd, humdID, _, _, _, _,_,_,_,_) =&gt; (temp, tempID, humd, humdID)
            end
    in
        let
            val (temp, tempID, humd, humdID) = getTempHum (siloID, inputDate, inputHour)
            val (avgGtemp, gtemp1ID, gtemp2ID, gtemp3ID) = getGrainTemp (siloID, inputDate, inputHour, extractedData)
        in
            (siloID, temp, tempID, humd, humdID, avgGtemp, gtemp1ID, gtemp2ID, gtemp3ID)
            
        end
    end;
