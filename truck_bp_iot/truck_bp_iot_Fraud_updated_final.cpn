      <block id="ID1475391882">
        <id>Rainfall data extraction</id>
        <ml id="ID1475392715">fun extractRainfall data =
    let
        fun extractRow [] = []
          | extractRow (row :: rest) =
            case row of
                [date, rainfall] =&gt;
                    (date, case Real.fromString rainfall of 
                                SOME r =&gt; r 
                              | NONE =&gt; 0.0) :: extractRow rest
                | _ =&gt; extractRow rest
    in
        extractRow (List.tl data) (* Skip header row *)
    end;
          <layout>fun extractRainfall data =
