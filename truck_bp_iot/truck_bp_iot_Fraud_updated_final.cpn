        <ml id="ID1438797999">fun extractEmptyWeightHistory data =
    let
        fun extractRow [] = []
          | extractRow ((RFIDNo::manufactured_weight::last_but_one_empty_weight::last_weighed_empty_weight::[]) :: rest) =
              let
                  val mw = case Real.fromString manufactured_weight of NONE =&gt; 0.0 | SOME realVal =&gt; realVal
                  val lbmw = case Real.fromString last_but_one_empty_weight of NONE =&gt; 0.0 | SOME realVal =&gt; realVal
                  val lmw = case Real.fromString last_weighed_empty_weight of NONE =&gt; 0.0 | SOME realVal =&gt; realVal
              in
                  (RFIDNo, mw, lbmw, lmw) :: extractRow rest
