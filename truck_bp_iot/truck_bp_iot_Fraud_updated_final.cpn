        <ml id="ID1453848776">fun daytimeshift() = uniform((7.0* hour), (16.0* hour + 59.0*minute));
fun eveningtimeshift() =uniform((17.0* hour), (21.0* hour + 59.0*minute));
          <layout>fun daytimeshift() = uniform((7.0* hour), (16.0* hour + 59.0*minute));
fun eveningtimeshift() =uniform((17.0* hour), (21.0* hour + 59.0*minute));</layout>
        </ml>
        <ml id="ID1457187731">fun nighttimeshift() =uniform((22.0* hour), (29.0* hour + 59.0*minute));
