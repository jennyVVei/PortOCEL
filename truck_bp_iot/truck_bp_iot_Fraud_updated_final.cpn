        <ml id="ID1436607667">fun CreatePPTime() =   
let   
val random_num = round(uniform(1.0, 100.0))
val i = if random_num &lt;= 70 then 1
           else if random_num &gt; 70 andalso random_num&lt;= 90 then 2
           else 3
val shift = if i = 1 then daytimeshift()
                else if i = 2 then eveningtimeshift()
                else nighttimeshift()
val delay = round(shift)
in
delay
end;
          <layout>fun CreatePPTime() =   
let   
val random_num = round(uniform(1.0, 100.0))
val i = if random_num &lt;= 70 then 1
           else if random_num &gt; 70 andalso random_num&lt;= 90 then 2
           else 3
val shift = if i = 1 then daytimeshift()
                else if i = 2 then eveningtimeshift()
                else nighttimeshift()
val delay = round(shift)
in
delay
end;</layout>
        </ml>
