        <ml id="ID1448808789">fun write_determine_continuance(pp_id,tr_id,siid, tempID, temp,humdID,  humd, gtemp1ID, gtemp2ID, gtemp3ID,avgGtemp)=
let
val event_id = &quot;determine_continu_&quot;^tr_id^&quot;_&quot;^pp_id^&quot;_&quot;^siid
val date = t2s(now())
val event_continuance= [[event_id, siid, &quot;silo evaluated for pickup continuance&quot;]]
val e2o_relations = event_continuance
val tr_silo = [[tr_id, siid, &quot;Truck determined for continuing pickup at silo&quot;,date]]
val o2o_relations = tr_silo 
val temp_iot = [[tempID, siid, &quot;Temperature sensor measuring silo temperature&quot;,date]]
val humd_iot = [[humdID, siid, &quot;Humidity sensor measuring silo humidity&quot;,date]]
val gtemp1_iot = [[gtemp1ID, siid, &quot;1st Grain Termperature sensor located in the silo&quot;,date]]
val gtemp2_iot = [[gtemp2ID, siid, &quot;2nd Grain Termperature sensor located in the silo&quot;,date]]
val gtemp3_iot = [[gtemp3ID, siid, &quot;3rd Grain Termperature sensor located in the silo&quot;,date]]
val event_temp= [[event_id, tempID, &quot;Temperature sensor for determining the pickup continuation&quot;]]
val event_humd= [[event_id, humdID, &quot;Humidity sensor for determining the pickup continuation&quot;]]
val event_gtemp1= [[event_id, gtemp1ID, &quot;1st grain temperature sensor for determining the pickup continuation&quot;]]
val event_gtemp2= [[event_id, gtemp2ID, &quot;2nd grain temperature sensor for determining the pickup continuation&quot;]]
val event_gtemp3= [[event_id, gtemp3ID, &quot;3rd grain temperature sensor for determining the pickup continuation&quot;]]
in
(
write_event(event_id, &quot;Determine the Continuance of the Pickup&quot;, []);
write_e2o_relations(e2o_relations);
write_o2o_relations(o2o_relations);
write_o2IoTo_relations(temp_iot);
write_o2IoTo_relations(humd_iot);
write_o2IoTo_relations(gtemp1_iot);
write_o2IoTo_relations(gtemp2_iot);
write_o2IoTo_relations(gtemp3_iot);
write_e2IoTo_relations(event_temp);
write_e2IoTo_relations(event_humd);
write_e2IoTo_relations(event_gtemp1);
write_e2IoTo_relations(event_gtemp2);
write_e2IoTo_relations(event_gtemp3);
update_silo_env(siid,temp, humd,avgGtemp)
)
end;
