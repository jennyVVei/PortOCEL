        <ml id="ID1436027733">fun divideAndGetQuotient (a : real, b : real) =
 if a &lt;= b then 1
else   
let
        val quotient = Real.floor(a / b)
        val remainder = a - b *Real.fromInt(quotient)
    in
        if remainder = 0.0 then
            quotient
        else
            quotient + 1
    end;
          <layout>fun divideAndGetQuotient (a : real, b : real) =
