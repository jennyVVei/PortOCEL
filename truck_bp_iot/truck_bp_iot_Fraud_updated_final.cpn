          <block id="ID1469187116">
            <id>EntrytoRegister</id>
            <ml id="ID1476314441">fun check_and_update_locationER_2(lat, lon, gpsid, tr_id) =
  let
    val (lat_entry, lon_entry) = (21.9860, 100.4890)
    val (lat_warehouse, lon_warehouse) = (21.9940, 100.4930)

    val dir_lat = lat_warehouse - lat_entry
    val dir_lon = lon_warehouse - lon_entry
    val norm = Math.sqrt(dir_lat * dir_lat + dir_lon * dir_lon)
    val unit_lat = dir_lat / norm
    val unit_lon = dir_lon / norm


    val v_lat = lat - lat_entry
    val v_lon = lon - lon_entry

 
    val ortho_lat = 0.0 - unit_lon
    val ortho_lon = unit_lat
    val deviation = v_lat * ortho_lat + v_lon * ortho_lon


    val result = if Real.abs(deviation) &gt; 0.0002
                 then &quot;invalid&quot;
                 else &quot;valid&quot;
  in
    if result = &quot;invalid&quot; then
      let
        val date = t2s(now())
        val tr_gps_iot = [[gpsid, tr_id, &quot;GPS sensor tracking truck location&quot;, date]]
        val o2IoTo_relations = tr_gps_iot
      in
        (write_o2IoTo_relations(o2IoTo_relations);
         update_tr_location_validity_attr(tr_id))
      end
    else ()
  end;
