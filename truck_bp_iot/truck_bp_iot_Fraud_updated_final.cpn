            <ml id="ID1477400640">fun step_rfid_position_entry_to_register(rfid: string, pickupplan_id: string) : (real * real) =
  let
    val lat_min = 21.9860
    val lat_max = 21.9890
    val lon_min = 100.4890
    val lon_max = 100.4930
    val key = (rfid, pickupplan_id)

    val current_t =
      case List.find (fn (k, _) =&gt; k = key) (!rfid_entry_register_list) of
        SOME (_, t0) =&gt; t0
      | NONE =&gt; 0.0

 
    val new_t = if current_t &gt;= 1.0 then 1.0 else current_t + step_size

 
    val _ = rfid_entry_register_list := (key, new_t) :: List.filter (fn (k, _) =&gt; k &lt;&gt; key) (!rfid_entry_register_list)

    val (lat, lon) =
      if current_t = 0.0 then
        (lat_min, lon_min)
      else if new_t &gt;= 1.0 then
        (lat_max, lon_max)
      else
        generateGPS(new_t, lat_min, lat_max, lon_min, lon_max)
  in
    (lat, lon)
  end
