        <ml id="ID1436445556">fun oas_by_type(ot: ObjectType) = 
if ot=&quot;Pickup Plan&quot; then [&quot;Cargo ID&quot;,&quot;Num of trucks&quot;,&quot;Total pickup weight&quot;] else 
if ot=&quot;Truck&quot; then [&quot;RFID No&quot;,&quot;Pickup Plan ID&quot;, &quot;Cargo ID&quot;, &quot;LPT&quot;, &quot;Axles&quot;, &quot;Scheduled Pickup Weight&quot;, &quot;Truck Status&quot;, &quot;Truck Location Validity&quot;,&quot;Truck Weight&quot;, &quot;Truck_Weight_Status&quot;] else 
if ot=&quot;Cargo&quot; then [&quot;Cargo Type&quot;, &quot;Cargo stock weight(withholding)&quot;, &quot;Cargo stock weight(real)&quot;, &quot;Silo ID&quot;] else 
if ot=&quot;Silo&quot; then [&quot;Silo Status&quot;,&quot;Temperature&quot;,&quot;Humidity&quot;,&quot;Silo Temperature&quot;,&quot;Grain Temperature&quot;] else 
[];
