        val lon = real(round(uniform(lon_min, lon_max) * 10000.0)) / 10000.0
      in
        (lat, lon)
      end

    fun generateInvalidGPS () =
      let
        val i = floor(uniform(1.0,2.0))
        val p = uniform(0.0, 1.0) 
        val lat =
          if i =1 then lat_min - (p * 0.01) 
          else lat_max + (p * 0.01) 

        val lon =
          if i =1 then lon_min - (p* 0.01) 
          else lon_max + (p * 0.01) 
      in
        (real(round(lat * 10000.0)) / 10000.0, real(round(lon * 10000.0)) / 10000.0)
      end
  in
    if randomNum &lt;= 5 then generateInvalidGPS ()
    else generateValidGPS ()
  end;
              <layout>fun generateLoadedWeighToExitGPS (): (real * real) =
  let
    val lat_min = 21.9900
    val lat_max = 21.9950
    val lon_min = 100.5200
    val lon_max = 100.5300

    val randomNum = floor(uniform(1.0,100.0))

    fun generateValidGPS () =
      let
        val lat = real(round(uniform(lat_min, lat_max) * 10000.0)) / 10000.0
        val lon = real(round(uniform(lon_min, lon_max) * 10000.0)) / 10000.0
      in
        (lat, lon)
      end

    fun generateInvalidGPS () =
      let
        val i = floor(uniform(1.0,2.0))
        val p = uniform(0.0, 1.0) 
        val lat =
          if i =1 then lat_min - (p * 0.01) 
          else lat_max + (p * 0.01) 

        val lon =
          if i =1 then lon_min - (p* 0.01) 
          else lon_max + (p * 0.01) 
      in
        (real(round(lat * 10000.0)) / 10000.0, real(round(lon * 10000.0)) / 10000.0)
      end
  in
    if randomNum &lt;= 5 then generateInvalidGPS ()
    else generateValidGPS ()
  end;</layout>
            </ml>
            <ml id="ID1476251289">fun writeLoadedWeighToExitGGPSrecord (trid: string, ppid: string, rfid: string) =
  let
    val file = &quot;./TruckGPSRecord.csv&quot;
    val gpsID = &quot;GPS_&quot; ^ trid
    val date = t2s(now())
    val (lat, lon) = step_rfid_position_loaded_to_exit_new (rfid,ppid)
    val record = gpsID ^ &quot;,&quot; ^ rfid ^ &quot;,&quot; ^ ppid ^ &quot;,&quot; ^ date ^ &quot;,&quot; ^
                 Real.toString lat ^ &quot;,&quot; ^ Real.toString lon ^ &quot;\n&quot;
    val file_id = TextIO.openAppend file
    val _ = TextIO.output(file_id, record)
  in
    TextIO.closeOut file_id;
    (gpsID, lat, lon)
  end;
