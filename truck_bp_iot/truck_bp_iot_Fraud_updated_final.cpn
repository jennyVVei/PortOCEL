        <ml id="ID1431655259">fun generateIds(prefix: string, n: int) =
    let
        fun generate(id, listSoFar) =
            let
                val newId = prefix ^ Int.toString id
                val updatedList = listSoFar ^^ [newId]
            in
                if id = n then
                    updatedList
                else
                    generate(id + 1, updatedList)
            end
    in
        generate(1, [])
    end;
          <layout>fun generateIds(prefix: string, n: int) =
    let
        fun generate(id, listSoFar) =
            let
                val newId = prefix ^ Int.toString id
                val updatedList = listSoFar ^^ [newId]
            in
                if id = n then
                    updatedList
                else
                    generate(id + 1, updatedList)
            end
    in
        generate(1, [])
    end;</layout>
        </ml>
