          <ml id="ID1481475043">fun get_trip_params (key : string * string, norm : real) :
    (real * real * real * real * real * real * real) =
  case List.find (fn (k, _) =&gt; k = key) (!trip_params) of
      SOME (_, p) =&gt; p
    | NONE =&gt;
        let
          val step_sz    = uniform(0.035, 0.095)
          val gamma      = uniform(0.07, 0.15)
          val bias       = uniform(0.0, 1.0)
          val s1         = uniform(0.04, 0.08)
          val s2         = uniform(0.03, 0.07)
          val signf      = if uniform(0.0, 1.0) &lt; 0.5 then ~1.0 else 1.0
          val noise_sc   = 0.00018 * uniform(0.7, 1.3)
          val p = (step_sz, gamma, bias, s1, s2, signf, noise_sc)
          val _ = trip_params := (key, p) :: (!trip_params)
        in
          p
        end;
            <layout>fun get_trip_params (key : string * string, norm : real) :
    (real * real * real * real * real * real * real) =
  case List.find (fn (k, _) =&gt; k = key) (!trip_params) of
      SOME (_, p) =&gt; p
    | NONE =&gt;
        let
          val step_sz    = uniform(0.035, 0.095)
          val gamma      = uniform(0.07, 0.15)
          val bias       = uniform(0.0, 1.0)
          val s1         = uniform(0.04, 0.08)
          val s2         = uniform(0.03, 0.07)
          val signf      = if uniform(0.0, 1.0) &lt; 0.5 then ~1.0 else 1.0
          val noise_sc   = 0.00018 * uniform(0.7, 1.3)
          val p = (step_sz, gamma, bias, s1, s2, signf, noise_sc)
          val _ = trip_params := (key, p) :: (!trip_params)
        in
          p
        end;</layout>
          </ml>
          <ml id="ID1481475465">fun generateGPS_with_params
  (t : real,
   lat_min : real, lat_max : real,
   lon_min : real, lon_max : real,
   params : (real * real * real * real * real * real * real)) : (real * real) =
  let
    val direction_lat = lat_max - lat_min
    val direction_lon = lon_max - lon_min
    val norm = Math.sqrt(direction_lat * direction_lat + direction_lon * direction_lon)
    val unit_lat = direction_lat / norm
    val unit_lon = direction_lon / norm
    val ortho_lat = ~unit_lon
    val ortho_lon =  unit_lat

    val (step_sz, gamma, bias, sigma1, sigma2, wave_sign, noise_scale) = params
    val _ = step_sz  

    val t_jitter = uniform(~0.006, 0.006)
    val t_used   = Real.max(0.0, Real.min(1.0, t + t_jitter))

    val center1  = 0.25 + bias * 0.35
    val center2  = 0.55 + bias * 0.35

    val base_lat = lat_min + t * direction_lat
    val base_lon = lon_min + t * direction_lon

    val shape =
        0.6 * gaussian(t_used, center1, sigma1)
      + 0.4 * gaussian(t_used, center2, sigma2)

    val max_dev = gamma * norm

    val noise   = noise_scale * uniform(~1.0, 1.0)
    val wave    = wave_sign * (max_dev * shape) + noise

    val dev_lat0 = base_lat + wave * ortho_lat
    val dev_lon0 = base_lon + wave * ortho_lon

    val dev_lat  = Real.max(lat_min, Real.min(lat_max, dev_lat0))
    val dev_lon  = Real.max(lon_min, Real.min(lon_max, dev_lon0))
    val lat_rounded = real(round(dev_lat * 10000.0)) / 10000.0
    val lon_rounded = real(round(dev_lon * 10000.0)) / 10000.0
  in
    (lat_rounded, lon_rounded)
  end;
            <layout>fun generateGPS_with_params
  (t : real,
   lat_min : real, lat_max : real,
   lon_min : real, lon_max : real,
   params : (real * real * real * real * real * real * real)) : (real * real) =
  let
    val direction_lat = lat_max - lat_min
    val direction_lon = lon_max - lon_min
    val norm = Math.sqrt(direction_lat * direction_lat + direction_lon * direction_lon)
    val unit_lat = direction_lat / norm
    val unit_lon = direction_lon / norm
    val ortho_lat = ~unit_lon
    val ortho_lon =  unit_lat

    val (step_sz, gamma, bias, sigma1, sigma2, wave_sign, noise_scale) = params
    val _ = step_sz  

    val t_jitter = uniform(~0.006, 0.006)
    val t_used   = Real.max(0.0, Real.min(1.0, t + t_jitter))

    val center1  = 0.25 + bias * 0.35
    val center2  = 0.55 + bias * 0.35

    val base_lat = lat_min + t * direction_lat
    val base_lon = lon_min + t * direction_lon

    val shape =
        0.6 * gaussian(t_used, center1, sigma1)
      + 0.4 * gaussian(t_used, center2, sigma2)

    val max_dev = gamma * norm

    val noise   = noise_scale * uniform(~1.0, 1.0)
    val wave    = wave_sign * (max_dev * shape) + noise

    val dev_lat0 = base_lat + wave * ortho_lat
    val dev_lon0 = base_lon + wave * ortho_lon

    val dev_lat  = Real.max(lat_min, Real.min(lat_max, dev_lat0))
    val dev_lon  = Real.max(lon_min, Real.min(lon_max, dev_lon0))
    val lat_rounded = real(round(dev_lat * 10000.0)) / 10000.0
    val lon_rounded = real(round(dev_lon * 10000.0)) / 10000.0
  in
    (lat_rounded, lon_rounded)
  end;</layout>
