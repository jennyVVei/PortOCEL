          <ml id="ID1475910901">fun determineState () =
    let
         val randValue = randNum()
    in
        if randValue &lt; 94 then &quot;blocked&quot;
        else if randValue &lt; 96 then &quot;unblocked&quot;
        else &quot;partially blocked&quot;
    end;
            <layout>fun determineState () =
    let
         val randValue = randNum()
    in
        if randValue &lt; 94 then &quot;blocked&quot;
        else if randValue &lt; 96 then &quot;unblocked&quot;
        else &quot;partially blocked&quot;
    end;</layout>
          </ml>
          <ml id="ID1475998856">fun writeRecord (outfile: TextIO.outstream, wsid: string, sensor_id: string, wsl: string, date: string) =
    let 
        val status = determineState()  (* Get sensor state dynamically *)
        val ir_id = wsid ^ &quot;_&quot; ^ sensor_id  (* Format sensor ID correctly *)
        val record = ir_id ^ &quot;,&quot; ^ &quot;sensor&quot; ^ &quot;,&quot; ^ status ^ &quot;,&quot; ^ date ^ &quot;,&quot; ^ wsl ^ &quot;,&quot; ^ wsid ^ &quot;\n&quot;
    in
        TextIO.output(outfile, record);
        ()  (* Explicitly return unit to avoid syntax issues *)
    end;
            <layout>fun writeRecord (outfile: TextIO.outstream, wsid: string, sensor_id: string, wsl: string, date: string) =
    let 
        val status = determineState()  (* Get sensor state dynamically *)
        val ir_id = wsid ^ &quot;_&quot; ^ sensor_id  (* Format sensor ID correctly *)
        val record = ir_id ^ &quot;,&quot; ^ &quot;sensor&quot; ^ &quot;,&quot; ^ status ^ &quot;,&quot; ^ date ^ &quot;,&quot; ^ wsl ^ &quot;,&quot; ^ wsid ^ &quot;\n&quot;
    in
        TextIO.output(outfile, record);
        ()  (* Explicitly return unit to avoid syntax issues *)
    end;</layout>
          </ml>
          <ml id="ID1475999787">fun insertNewSensorRecords (wsid: string, wsl: string) =
    let
        val file_id = &quot;./InfraredSensorRecord.csv&quot;
        val outfile = TextIO.openAppend(file_id)  (* Correct file opening *)
        val date = t2s(now())  (* Convert timestamp to string *)
        val sensor_ids = [&quot;IR1&quot;, &quot;IR2&quot;, &quot;IR3&quot;, &quot;IR4&quot;]  
    in
        (* Iterate over all four sensors and write their records *)
        List.app (fn sensor_id =&gt; writeRecord(outfile, wsid, sensor_id, wsl, date)) sensor_ids;
        TextIO.closeOut(outfile)  (* Ensure file is properly closed *)
    end;
