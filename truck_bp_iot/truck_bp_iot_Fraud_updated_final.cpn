        <ml id="ID1431527265">fun write_tr_entry(tr_id, rfid,rain,pp_id) =
let
val event_id = &quot;enter_&quot;^tr_id^&quot;_&quot;^pp_id
val date = t2s(now())
val event_entry= [[event_id, tr_id, &quot;Entry evaluation for truck&quot;]]
val e2o_relations = event_entry
val event_entry_iot= [[event_id, rfid, &quot;RFID tag read at entrance&quot;]]
val e2IoTo_relations = event_entry_iot
val seconds = now()
in
(
write_event(event_id, &quot;Enter the port&quot;, [rain]);
write_e2o_relations(e2o_relations);
write_e2IoTo_relations(e2IoTo_relations);
(date, seconds)
)
end;
